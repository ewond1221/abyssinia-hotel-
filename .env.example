# Copy these into Vercel: Project > Settings > Environment Variables.
# NEVER commit a real .env file (it is already in .gitignore) and never put these in front-end code.

# Random string, 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The site REFUSES TO START on Vercel without it.
JWT_SECRET_KEY=

# Your PostgreSQL connection string (server-side only).
DATABASE_URL=

# Optional: only used to create the very first admin when the database has none.
# 12+ characters. After the first login you can delete these two lines.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
